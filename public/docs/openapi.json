  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Jeton reçu à la connexion, valable 24 heures."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "errors"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": []
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "julien@example.test"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72,
            "example": "demonstration-12345"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PortfolioInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Mon portefeuille"
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR"
            ],
            "default": "EUR"
          }
        },
        "required": [
          "name"
        ]
      },
      "Portfolio": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR"
            ]
          }
        },
        "required": []
      },
      "Asset": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "isin": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "etf",
              "fund",
              "stock",
              "bond"
            ]
          }
        },
        "required": []
      },
      "Price": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "value": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d{1,8})?$",
            "example": "10.50"
          },
          "quoted_on": {
            "type": "string",
            "format": "date"
          }
        },
        "required": []
      },
      "TradeInput": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "integer",
            "minimum": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "quantity": {
            "type": "string",
